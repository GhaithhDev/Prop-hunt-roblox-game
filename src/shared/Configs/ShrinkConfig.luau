function ShrinkConfig.GetScaleForLevel(level: number, world: number?): number
	local worldNum = (world and tonumber(world)) or 1
	local range = ShrinkConfig.LevelRangeByWorld[worldNum] or ShrinkConfig.LevelRangeByWorld[1]
	if level <= range.MinLevel then
		return ShrinkConfig.BaseScale
	end
	if level >= range.MaxLevel then
		return ShrinkConfig.MinScale
	end
	local levelTable = ShrinkConfig.ScaleByLevelByWorld[worldNum] or ShrinkConfig.ScaleByLevelByWorld[1]
	return levelTable[level]
end

-- Shared clamp formula for "what scale should this character actually be
-- right now" - the level-based floor, optionally overridden up to a manually
-- chosen customScale (never below the floor, never above BaseScale). Every
-- client computes this identically for every player from the same replicated
-- Level/CustomScale/World inputs, which is what keeps everyone's view in sync
-- without the server ever calling ScaleTo itself.
function ShrinkConfig.GetEffectiveScale(level: number, customScale: number?, world: number?): number
	local minScale = ShrinkConfig.GetScaleForLevel(level, world)
	if customScale then
		return math.clamp(customScale, minScale, ShrinkConfig.BaseScale)
	end
	return minScale
end

-- ShrinkScore is a purely cosmetic, ever-increasing display number for the
-- level-up notification - it is NOT the real character scale (see
-- GetScaleForLevel above) and is unrelated to the "Shrink" XP/currency stat
-- (Template.Shrink). Raw scale deltas near 1.0 are visually unappealing, so
-- this maps each world's own Level range to 1 -> MaxShrinkScore, then keeps
-- climbing a flat amount per level forever after in the last configured
-- world (MaxWorld), since Level itself is uncapped (see LevelConfig/RebirthConfig).
ShrinkConfig.MaxShrinkScore = 1000
ShrinkConfig.PostCapShrinkScorePerLevel = 50

