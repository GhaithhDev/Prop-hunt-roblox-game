function ShrinkConfig.GetShrinkScoreForLevel(level: number, world: number?): number
	local worldNum = (world and tonumber(world)) or 1
	local range = ShrinkConfig.LevelRangeByWorld[worldNum] or ShrinkConfig.LevelRangeByWorld[1]
	if level <= range.MinLevel then
		return 1
	end
	if level >= range.MaxLevel then
		if worldNum >= ShrinkConfig.MaxWorld then
			return ShrinkConfig.MaxShrinkScore + (level - range.MaxLevel) * ShrinkConfig.PostCapShrinkScorePerLevel
		end
		return ShrinkConfig.MaxShrinkScore
	end
	local levelTable = ShrinkConfig.ShrinkScoreByLevelByWorld[worldNum] or ShrinkConfig.ShrinkScoreByLevelByWorld[1]
	return levelTable[level]
end

return ShrinkConfig
