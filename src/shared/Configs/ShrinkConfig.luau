local ShrinkConfig = {}

ShrinkConfig.BaseScale = 1.0
ShrinkConfig.MinScale = 0.2

-- Per-world Level range each world's shrink curve maps onto - Level is a
-- single ever-increasing global stat (never reset by world changes), but
-- each world maps the player's raw Level (clamped to its own MinLevel..
-- MaxLevel) back onto scale 1.0 (BaseScale) -> 0.2 (MinScale) and shrink
-- score 1 -> MaxShrinkScore, independently of the other worlds' curves.
-- World is the player's *current* World (see DataManager "World" / the
-- replicated PlayerData.World value used everywhere else in the codebase).
ShrinkConfig.MaxWorld = 3
ShrinkConfig.LevelRangeByWorld = {
	[1] = { MinLevel = 1, MaxLevel = 400 },
	[2] = { MinLevel = 1, MaxLevel = 875 },
	[3] = { MinLevel = 1, MaxLevel = 1800 },
