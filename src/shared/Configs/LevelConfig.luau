function LevelConfig.GetXpRequiredForLevel(level: number): number
	if level <= 1 then
		return 0
	end
	if level <= LevelConfig.MaxPrecomputedLevel then
		return LevelConfig.XpThresholds[level]
	end
	-- Closed-form sum of the geometric step series: BaseXp * (GrowthRate^(level-1) - 1) / (GrowthRate - 1)
	return math.round(LevelConfig.BaseXp * (LevelConfig.GrowthRate ^ (level - 1) - 1) / (LevelConfig.GrowthRate - 1))
end

return LevelConfig
