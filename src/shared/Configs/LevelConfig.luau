LevelConfig.Exponent = 1.4
LevelConfig.MaxPrecomputedLevel = 2000

-- The XP *increment* needed to advance from level n to n+1 is
-- StepXp(n) = round(BaseFactor * n ^ Exponent).
-- Because Exponent > 1, the step size itself grows faster and faster as n
-- increases -- early levels are cheap (level 1->2 costs 13 XP) and the
-- grind ramps up increasingly steeply the higher you go, rather than
-- growing by a fixed amount each level. BaseFactor is tuned so level 400
-- still costs about the same total XP as it did before (~9.47M, matching
-- old level 50's grind) -- the finish line difficulty is unchanged, only
-- the *shape* of the climb to get there: quick early gains, harder later ones.
-- Threshold(n) is the running sum of those increments (Threshold(1) = 0).
-- Precomputed so individual levels can be hand-tuned here without touching code.
