function SpeedConfig.GetSpeedForLevel(level: number): number
	if level <= 1 then
		return SpeedConfig.BaseSpeed
	end
	if level >= SpeedConfig.MaxLevel then
		return SpeedConfig.MaxSpeed
	end
	return SpeedConfig.SpeedByLevel[level]
end

return SpeedConfig
